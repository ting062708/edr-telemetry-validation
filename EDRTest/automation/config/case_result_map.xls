<Worksheet ss:Name="case_result"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Case ID</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">模块</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">行为</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">判定</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">打问号</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">有记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">无记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">情况说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-CREATE-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">本地账户创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">AccountCreate(4720)，lsass 执行需 skip_process_anchor + target_user</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-LOGIN-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">账户登录</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">LoginSuccess(4624)，样本进程 MD5 锚定 + target_user + logon_type=交互式</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-LOAD-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动加载</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">LoadDriver 内核态事件(Parent=SystemIdle)，时间窗 + Action.Name + Child.FilePath 锚定</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动修改</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">本质是文件修改(FileWriteClose)，非驱动事件，Parent=样本进程</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-CREATE-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 无独立 FileCreate 事件，落 FileWriteClose，靠 Child.FileTotalWrite=0 锚定&quot;纯创建&quot;</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-DELETE-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件删除</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileDelete 独立采到，sleep 5s 避开&quot;同毫秒建删&quot;去重</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件修改</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileWriteClose 采到</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-RENAME-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件重命名</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileRename 采到，Child.OldFilePath 字段实证存在</Data></Cell></Row><Row><Cell><Data ss:Type="String">NET-DOWNLOAD-001</Data></Cell><Cell><Data ss:Type="String">网络</Data></Cell><Cell><Data ss:Type="String">文件下载</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">HttpsRequest(Host=proof.ovh.net)</Data></Cell></Row><Row><Cell><Data ss:Type="String">NET-TCP-001</Data></Cell><Cell><Data ss:Type="String">网络</Data></Cell><Cell><Data ss:Type="String">TCP 连接</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">HttpRequest(DstIp=93.184.216.34:80)</Data></Cell></Row><Row><Cell><Data ss:Type="String">NET-URL-001</Data></Cell><Cell><Data ss:Type="String">网络</Data></Cell><Cell><Data ss:Type="String">URL 访问</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">HttpsRequest(Host=www.baidu.com)，Child.Url 为空、实际在 Host</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-CREATE-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">RegSetValue 值从无到有（新增 notepad.exe），锚定 Child.RegValName/RegKeyPath/RegValData</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-OPEN-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件打开</Data></Cell><Cell ss:StyleID="maybe"><Data ss:Type="String">通过(部分)?</Data></Cell><Cell><Data ss:Type="String">?</Data></Cell><Cell><Data ss:Type="String">系统进程读 .cab → FileRead（2~3 条）</Data></Cell><Cell><Data ss:Type="String">样本读 .txt → 无 FileRead；样本读 .exe → 无 FileRead</Data></Cell><Cell><Data ss:Type="String">IOA 有 FileRead 事件类型，但样本读普通文件不触发；采到的 .cab 读是系统进程行为，非样本行为。行业 Sysmon/MDE/SentinelOne 均=No。是否算&quot;部分有记录&quot;待与导师确认</Data></Cell></Row><Row><Cell><Data ss:Type="String">NET-UDP-001</Data></Cell><Cell><Data ss:Type="String">网络</Data></Cell><Cell><Data ss:Type="String">UDP 连接</Data></Cell><Cell ss:StyleID="maybe"><Data ss:Type="String">通过(部分)?</Data></Cell><Cell><Data ss:Type="String">?</Data></Cell><Cell><Data ss:Type="String">系统进程广播/组播 → SocketRequest(34 条, svchost/dashost)</Data></Cell><Cell><Data ss:Type="String">样本单播 sendto(8.8.8.8:53) → 无记录</Data></Cell><Cell><Data ss:Type="String">SocketRequest 有记录，但全部是系统进程的广播/组播，样本单播 UDP 未采。采到的是系统行为非样本行为。待与导师确认</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值修改</Data></Cell><Cell ss:StyleID="maybe"><Data ss:Type="String">通过(部分)?</Data></Cell><Cell><Data ss:Type="String">?</Data></Cell><Cell><Data ss:Type="String">值从无到有(ABSENT→value) → RegSetValue（SETUP 预置阶段能采）</Data></Cell><Cell><Data ss:Type="String">覆盖写已有值(notepad→calc) → 无事件</Data></Cell><Cell><Data ss:Type="String">IOA 只采&quot;值从无到有&quot;，覆盖写不触发 RegSetValue。&quot;修改&quot;动作本身未被采到，仅边缘情况有记录。待与导师确认</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-DELETE-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">本地账户删除</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">无 4726 账户删除事件</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-LOGOFF-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">账户注销</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">无 4634/4647 注销事件（行业 MDE 也是 No，属常态缺口）</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">本地账户修改</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">改密码(NetUserSetInfo 1003)无独立事件；AccountPwdReset 是建账户副产品，4723 全表 0</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-UNLOAD-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动卸载</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 只有&quot;加载驱动 LoadDriver&quot;，无&quot;卸载驱动&quot;事件</Data></Cell></Row><Row><Cell><Data ss:Type="String">NET-DNS-001</Data></Cell><Cell><Data ss:Type="String">网络</Data></Cell><Cell><Data ss:Type="String">DNS 查询</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">DnsQuery_W 无对应事件，IOA 不采 DNS 解析</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-DELETE-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值删除</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 无 RegDeleteValue/RegDeleteKey/RegCreateKey 事件，删值能力缺失</Data></Cell></Row></Table></Worksheet></Workbook>