<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40">
<Styles><Style ss:ID="header"><Font ss:Bold="1"/><Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/></Style><Style ss:ID="pass"><Interior ss:Color="#C6EFCE" ss:Pattern="Solid"/></Style><Style ss:ID="maybe"><Interior ss:Color="#FFEB9C" ss:Pattern="Solid"/></Style><Style ss:ID="fail"><Interior ss:Color="#FFC7CE" ss:Pattern="Solid"/></Style></Styles>
<Worksheet ss:Name="case_result"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Case ID</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">模块</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">行为</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">判定</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">打问号</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">有记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">无记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">情况说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-LOAD-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动加载</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">LoadDriver 内核态事件(Parent=SystemIdle)，时间窗 + Action.Name + Child.FilePath 锚定</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动修改</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">本质是文件修改(FileWriteClose)，非驱动事件，Parent=样本进程</Data></Cell></Row><Row><Cell><Data ss:Type="String">DRIVER-UNLOAD-001</Data></Cell><Cell><Data ss:Type="String">驱动</Data></Cell><Cell><Data ss:Type="String">驱动卸载</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 只有&quot;加载驱动 LoadDriver&quot;，无&quot;卸载驱动&quot;事件</Data></Cell></Row></Table></Worksheet></Workbook>