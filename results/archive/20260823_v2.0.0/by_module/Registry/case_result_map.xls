<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40">
<Styles><Style ss:ID="header"><Font ss:Bold="1"/><Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/></Style><Style ss:ID="pass"><Interior ss:Color="#C6EFCE" ss:Pattern="Solid"/></Style><Style ss:ID="maybe"><Interior ss:Color="#FFEB9C" ss:Pattern="Solid"/></Style><Style ss:ID="fail"><Interior ss:Color="#FFC7CE" ss:Pattern="Solid"/></Style></Styles>
<Worksheet ss:Name="case_result"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Case ID</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">模块</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">行为</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">判定</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">打问号</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">有记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">无记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">情况说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-CREATE-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">RegSetValue 值从无到有（新增 notepad.exe），锚定 Child.RegValName/RegKeyPath/RegValData</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值修改</Data></Cell><Cell ss:StyleID="maybe"><Data ss:Type="String">通过(部分)?</Data></Cell><Cell><Data ss:Type="String">?</Data></Cell><Cell><Data ss:Type="String">值从无到有(ABSENT→value) → RegSetValue（SETUP 预置阶段能采）</Data></Cell><Cell><Data ss:Type="String">覆盖写已有值(notepad→calc) → 无事件</Data></Cell><Cell><Data ss:Type="String">IOA 只采&quot;值从无到有&quot;，覆盖写不触发 RegSetValue。&quot;修改&quot;动作本身未被采到，仅边缘情况有记录。待与导师确认</Data></Cell></Row><Row><Cell><Data ss:Type="String">REG-DELETE-001</Data></Cell><Cell><Data ss:Type="String">注册表</Data></Cell><Cell><Data ss:Type="String">键/值删除</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 无 RegDeleteValue/RegDeleteKey/RegCreateKey 事件，删值能力缺失</Data></Cell></Row></Table></Worksheet></Workbook>