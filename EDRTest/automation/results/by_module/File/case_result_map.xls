<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40">
<Styles><Style ss:ID="header"><Font ss:Bold="1"/><Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/></Style><Style ss:ID="pass"><Interior ss:Color="#C6EFCE" ss:Pattern="Solid"/></Style><Style ss:ID="maybe"><Interior ss:Color="#FFEB9C" ss:Pattern="Solid"/></Style><Style ss:ID="fail"><Interior ss:Color="#FFC7CE" ss:Pattern="Solid"/></Style></Styles>
<Worksheet ss:Name="case_result"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Case ID</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">模块</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">行为</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">判定</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">打问号</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">有记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">无记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">情况说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-CREATE-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">IOA 无独立 FileCreate 事件，落 FileWriteClose，靠 Child.FileTotalWrite=0 锚定&quot;纯创建&quot;</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-DELETE-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件删除</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileDelete 独立采到，sleep 5s 避开&quot;同毫秒建删&quot;去重</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-MODIFY-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件修改</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileWriteClose 采到</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-RENAME-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件重命名</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">FileRename 采到，Child.OldFilePath 字段实证存在</Data></Cell></Row><Row><Cell><Data ss:Type="String">FILE-OPEN-001</Data></Cell><Cell><Data ss:Type="String">文件</Data></Cell><Cell><Data ss:Type="String">文件打开</Data></Cell><Cell ss:StyleID="maybe"><Data ss:Type="String">通过(部分)?</Data></Cell><Cell><Data ss:Type="String">?</Data></Cell><Cell><Data ss:Type="String">系统进程读 .cab → FileRead（2~3 条）</Data></Cell><Cell><Data ss:Type="String">样本读 .txt → 无 FileRead；样本读 .exe → 无 FileRead</Data></Cell><Cell><Data ss:Type="String">IOA 有 FileRead 事件类型，但样本读普通文件不触发；采到的 .cab 读是系统进程行为，非样本行为。行业 Sysmon/MDE/SentinelOne 均=No。是否算&quot;部分有记录&quot;待与导师确认</Data></Cell></Row></Table></Worksheet></Workbook>