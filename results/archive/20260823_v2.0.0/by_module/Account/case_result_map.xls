<Worksheet ss:Name="case_result"><Table><Row><Cell ss:StyleID="header"><Data ss:Type="String">Case ID</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">模块</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">行为</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">判定</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">打问号</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">有记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">无记录</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">情况说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-CREATE-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">本地账户创建</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">AccountCreate(4720)，lsass 执行需 skip_process_anchor + target_user</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-LOGIN-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">账户登录</Data></Cell><Cell ss:StyleID="pass"><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">LoginSuccess(4624)，样本进程 MD5 锚定 + target_user + logon_type=交互式</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-DELETE-001</Data></Cell><Cell><Data ss:Type="String">账户</Data></Cell><Cell><Data ss:Type="String">本地账户删除</Data></Cell><Cell ss:StyleID="fail"><Data ss:Type="String">未通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">无 4726 账户删除事件</Data></Cell></Row><Row><Cell><Data ss:Type="String">ACCOUNT-LOGOFF-001</Data></Cell><Cell><Data ss: